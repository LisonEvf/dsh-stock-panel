{
  "name": "@lisonevf/dsh-stock-panel",
  "version": "0.4.0",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "description": "A股量化工作台 — DSH Web 插件（主布局第四列，MCP 数据源）",
  "type": "module",
  "main": "./lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "immediately": false
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@tanstack/react-query": "^5.55.0",
    "clsx": "^2.1.1",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "rolldown": "1.0.0-beta.21",
    "tailwindcss": "^3.4.10",
    "tailwindcss-animate": "^1.0.7",
    "tsdown": "0.13.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-css-injected-by-js": "^5.0.2"
  },
  "scripts": {
    "build": "tsdown -c tsdown.config.ts && node scripts/build-client.mjs && node scripts/postbuild-dts.mjs",
    "prepare": "pnpm build",
    "watch": "tsdown --watch",
    "publish": "npm publish --registry=https://npm.pkg.github.com"
  }
}
