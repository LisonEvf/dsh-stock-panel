{
  "name": "@lisonevf/dsh-stock-panel",
  "version": "1.4.0",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "description": "A股量化工作台 — DSH Web 插件（官方 conversation.view 视图标签页：宽视图沉浸式盯盘台 + AI 一键研判）",
  "type": "module",
  "main": "./lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "immediately": false
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tailwindcss-animate": "^1.0.7",
    "tsdown": "0.13.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0"
  },
  "scripts": {
    "build": "tsdown -c tsdown.config.ts && node scripts/build-client.mjs && node scripts/postbuild-dts.mjs",
    "prepare": "pnpm build",
    "watch": "tsdown --watch",
    "smoke:view": "node scripts/smoke-client-view.mjs",
    "smoke:ai": "node scripts/smoke-ai-contract.mjs",
    "smoke:host": "node scripts/smoke-host-state.mjs",
    "lint": "eslint src scripts --max-warnings 30",
    "lint:fix": "eslint src scripts --fix",
    "test": "node scripts/unit.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:domain": "node scripts/verify-state-domain.mjs",
    "report:bundle": "node scripts/bundle-report.mjs --minify",
    "concept:sweep": "node scripts/concept-sweep.mjs",
    "concept:stability": "node scripts/concept-stability.mjs",
    "publish": "npm publish --registry=https://npm.pkg.github.com"
  }
}
